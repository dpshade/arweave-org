---
import Layout from "../layouts/Layout.astro";

// Sample project data - simplified for wireframe compliance
const sampleProjects = [
  {
    id: 1,
    title: "Proposed Research",
    description: "Submit Research Proposals to fund research within their relevant verticals through ecosystem distribution. Funds are allocated through consensus distribution.",
    category: "Research"
  },
  {
    id: 2,
    title: "ArDrive",
    description: "A privacy-first, permanent data storage platform that leverages the Arweave network to store your files forever with zero compromises.",
    category: "Data Storage"
  },
  {
    id: 3,
    title: "Warp SDK",
    description: "SmartWeave SDK that enables building high-performance dApps with smart contracts on the Arweave ecosystem.",
    category: "Web Apps"
  },
  {
    id: 4,
    title: "ArConnect",
    description: "A secure wallet management extension for the Arweave ecosystem. Connect your wallet to dApps with confidence.",
    category: "Web Apps"
  },
  {
    id: 5,
    title: "Permafacts",
    description: "Permanent fact verification on the Arweave network. Store and verify information with cryptographic proof of authenticity.",
    category: "Data Tools"
  },
  {
    id: 6,
    title: "Arweave Social",
    description: "Decentralized social media platform built on permanent storage. Your posts, your data, forever accessible.",
    category: "Social"
  }
];

const categories = ["All Categories", "Web Apps", "Data Storage", "DeFi", "Social", "Data Tools", "Research"];
---

<Layout title="Discover - Arweave Projects">
  <main class="discover-page" role="main">
    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="page-title">
      <div class="brand-container">
        <h1 id="page-title" class="hero-title">Discover Arweave.</h1>
        <h2 class="hero-subtitle">Find projects.</h2>
        <p class="hero-tagline">Apps & Infrastructure built on the foundation of permanent data.</p>
      </div>
    </section>
    
    <!-- Search & Filter Section -->
    <section class="search-section" aria-label="Project search and filters">
      <div class="brand-container">
        <div class="search-filter-controls">
          <!-- Search Bar -->
          <div class="search-container">
            <input 
              type="search" 
              id="project-search"
              placeholder="Search projects..." 
              class="search-input"
              aria-label="Search projects"
            />
            <button class="search-button" aria-label="Search">
              <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </div>
          
          <!-- Filter Controls -->
          <div class="filter-controls">
            <select class="filter-select" id="category-filter" aria-label="Filter by category">
              {categories.map(category => (
                <option value={category.toLowerCase().replace(' ', '-')}>{category}</option>
              ))}
            </select>
          </div>
          
          <!-- Project Counter -->
          <div class="project-counter">
            <span class="counter-text">150 projects</span>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Projects Grid Section -->
    <section class="projects-section" aria-label="Project listings">
      <div class="brand-container">
        <div class="projects-grid" id="projects-grid">
          {sampleProjects.map(project => (
            <article class="project-card" data-category={project.category.toLowerCase().replace(' ', '-')} tabindex="0">
              <div class="project-icon">
                <svg class="icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <polyline points="21,15 16,10 5,21"></polyline>
                </svg>
              </div>
              
              <div class="card-content">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-description">{project.description}</p>
              </div>
              
              <div class="card-footer">
                <span class="category-tag">{project.category}</span>
              </div>
            </article>
          ))}
        </div>
        
        <!-- Load More Button -->
        <div class="load-more-section">
          <button class="load-more-btn">Load More</button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Brand variables */
  :root {
    --card-border: #E5E5E5;
  }

  /* Container and Layout */
  .discover-page {
    min-height: calc(100vh - 64px);
  }

  /* Hero Section */
  .hero-section {
    padding: var(--space-3xl) 0;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-primary);
    font-size: var(--text-headline-large-size);
    font-weight: 400;
    line-height: var(--text-headline-large-line-height);
    letter-spacing: var(--text-headline-large-letter-spacing);
    color: var(--primary-black);
    margin: 0 0 var(--space-sm) 0;
  }

  .hero-subtitle {
    font-family: var(--font-primary);
    font-size: var(--text-headline-medium-size);
    font-weight: 400;
    line-height: var(--text-headline-medium-line-height);
    color: var(--primary-black);
    margin: 0 0 var(--space-md) 0;
  }

  .hero-tagline {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 400;
    line-height: 175%;
    letter-spacing: 0.04em;
    color: var(--primary-gray);
    margin: 0 auto;
    max-width: 600px;
  }

  /* Search & Filter Section */
  .search-section {
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--card-border);
    margin-bottom: var(--space-2xl);
  }

  .search-filter-controls {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .search-container {
    position: relative;
    flex: 1;
    max-width: 400px;
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding: 0 50px 0 var(--space-md);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 400;
    color: var(--brand-black);
    background: var(--background-white);
  }

  .search-input:focus {
    outline: 2px solid var(--brand-orange);
    border-color: var(--brand-orange);
  }

  .search-input::placeholder {
    color: var(--primary-gray);
  }

  .search-button {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--primary-gray);
  }

  .search-button:hover {
    color: var(--brand-orange);
  }

  .filter-controls {
    display: flex;
    gap: var(--space-md);
  }

  .filter-select {
    height: 48px;
    padding: 0 var(--space-md);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 400;
    color: var(--brand-black);
    background: var(--background-white);
    cursor: pointer;
    min-width: 140px;
  }

  .filter-select:focus {
    outline: 2px solid var(--brand-orange);
    border-color: var(--brand-orange);
  }

  .project-counter {
    display: flex;
    align-items: center;
  }

  .counter-text {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--primary-gray);
  }

  /* Projects Grid */
  .projects-section {
    padding-bottom: var(--space-3xl);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  /* Project Cards */
  .project-card {
    background: var(--background-white);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--brand-orange);
  }

  .project-card:focus {
    outline: 2px solid var(--brand-orange);
    outline-offset: 2px;
  }

  .project-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--subtle-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-gray);
    margin-bottom: var(--space-md);
  }

  .card-content {
    flex: 1;
    margin-bottom: var(--space-md);
  }

  .project-title {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 500;
    line-height: 32px;
    color: var(--brand-black);
    margin: 0 0 var(--space-sm) 0;
  }

  .project-description {
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    color: var(--primary-gray);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
  }

  .category-tag {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    color: var(--brand-orange);
    background: rgba(246, 103, 0, 0.1);
    padding: var(--space-xs) var(--space-sm);
    border-radius: 4px;
  }

  /* Load More Section */
  .load-more-section {
    text-align: center;
  }

  .load-more-btn {
    background: var(--brand-orange);
    color: var(--background-white);
    border: none;
    padding: 12px var(--space-lg);
    border-radius: 6px;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
  }

  .load-more-btn:hover {
    background: #E55A00;
  }

  .load-more-btn:focus {
    outline: 2px solid var(--brand-orange);
    outline-offset: 2px;
  }

  /* Responsive Design */
  @media (max-width: 767px) {
    .hero-section {
      padding: var(--space-2xl) 0;
    }

    .hero-title {
      font-size: 48px;
      line-height: 110%;
    }

    .hero-subtitle {
      font-size: 32px;
    }

    .hero-tagline {
      font-size: 14px;
      line-height: 150%;
    }

    .search-filter-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .search-container {
      max-width: none;
    }

    .filter-controls {
      justify-content: space-between;
    }

    .filter-select {
      flex: 1;
      min-width: auto;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .project-card {
      padding: var(--space-md);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-title {
      font-size: 64px;
    }

    .hero-subtitle {
      font-size: 48px;
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  /* Hidden state for filtered items */
  .project-card.hidden {
    display: none;
  }
</style>

<script>
  // Simple Search and Filter Functionality
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
    const projectCards = document.querySelectorAll('.project-card');
    const loadMoreBtn = document.querySelector('.load-more-btn') as HTMLButtonElement;

    let currentCategory = 'all-categories';
    let searchTerm = '';

    // Filter projects based on search and category
    function filterProjects() {
      projectCards.forEach(card => {
        const titleElement = card.querySelector('.project-title');
        const descriptionElement = card.querySelector('.project-description');
        const title = titleElement?.textContent?.toLowerCase() || '';
        const description = descriptionElement?.textContent?.toLowerCase() || '';
        const category = card.getAttribute('data-category') || '';
        
        const matchesSearch = searchTerm === '' || title.includes(searchTerm) || description.includes(searchTerm);
        const matchesCategory = currentCategory === 'all-categories' || category === currentCategory;
        
        if (matchesSearch && matchesCategory) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    // Search input handler
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        searchTerm = target.value.toLowerCase();
        filterProjects();
      });
    }

    // Category filter handler
    if (categoryFilter) {
      categoryFilter.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        currentCategory = target.value;
        filterProjects();
      });
    }

    // Load more functionality
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        console.log('Loading more projects...');
        // In a real implementation, this would load more projects from an API
      });
    }

    // Card click handler
    projectCards.forEach(card => {
      card.addEventListener('click', () => {
        const titleElement = card.querySelector('.project-title');
        const title = titleElement?.textContent || 'Unknown Project';
        console.log('Opening project:', title);
        // In a real implementation, this would navigate to the project details page
      });

      // Keyboard navigation
      card.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          (card as HTMLElement).click();
        }
      });
    });
  });
</script>